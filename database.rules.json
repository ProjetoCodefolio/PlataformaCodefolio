        ".read": true,
        ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin') && !newData.exists()",
        "$slideId": {
          ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')"
        }
      }
    },

    "courseVideos": {
      "$courseId": {
        ".read": true,
        ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin') && !newData.exists()",
        "$videoId": {
          ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')"
        }
      }
    },

    "courseContent": {
      "$courseId": {
        ".read": true,
        ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin') && !newData.exists()",
        "$contentId": {
          ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')"
        }
      }
    },
    
    "courseAliases": {
      "$aliasId": {
        ".read": true,
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (data.exists() && root.child('courses').child(data.child('courseId').val()).child('userId').val() === auth.uid) || (!data.exists() && root.child('courses').child(newData.child('courseId').val()).child('userId').val() === auth.uid))"
      }
    },

    "courses": {
      "$courseId": {
        ".read": true,
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (data.exists() && data.child('userId').val() === auth.uid) || (!data.exists() && root.child('users').child(auth.uid).child('role').val() === 'teacher'))"
      }
    },

    "courseAdvancedSettings": {
      "$courseId": {
        ".read": true,
        ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },

    "courseAttendanceSettings": {
      "$courseId": {
        ".read": true,
        ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },

    "customQuizResults": {
      "$courseId": {
        ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin') && !newData.exists()",
        "$quizId": {
          ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
          "$userId": {
            ".write": "auth != null && auth.uid === $userId",
            ".read": "auth != null && root.child('courses').child($courseId).child('userId').val() === auth.uid"
          }
        }
      }
    },

    "liveQuizResults": {
      "$courseId": {
        ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin') && !newData.exists()",
        "$quizId": {
          ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
          "$userId": {
            ".write": "auth != null && auth.uid === $userId",
            ".read": "auth != null && root.child('courses').child($courseId).child('userId').val() === auth.uid"
          }
        }
      }
    },

    "openEndedAnswers": {
      "$courseId": {
        ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin') && !newData.exists()",
        "$quizId": {
          ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
          "$questionId": {
            "$userId": {
              ".write": "auth != null && (auth.uid === $userId || root.child('courses').child($courseId).child('userId').val() === auth.uid)",
              ".read": "auth != null && (auth.uid === $userId || root.child('courses').child($courseId).child('userId').val() === auth.uid)"
            }
          }
        }
      }
    },

    "llmModels": {
      "$modelId": {
        ".read": true,
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },

    "post": {
