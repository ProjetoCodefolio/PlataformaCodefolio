{
  "rules": {
    ".read": false,
    ".write": false,

    "courseAssessments": {
      "$courseId": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('coursesTeacher').child($courseId).exists()) && !newData.exists()",
        "$assessmentId": {
          ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('coursesTeacher').child($courseId).exists())",
          ".read": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || data.child('userId').val() === auth.uid)"
        }
      }
    },

    "courseAssignments": {
      "$courseId": {
        ".read": true,
        ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('coursesTeacher').child($courseId).exists()) && !newData.exists()",
        "$assignmentId": {
          ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('coursesTeacher').child($courseId).exists())"
        }
      }
    },

    "assignmentGroups": {
      "$courseId": {
        ".read": true,
        ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('coursesTeacher').child($courseId).exists()) && !newData.exists()",
        "$assignmentId": {
          ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('coursesTeacher').child($courseId).exists())",
          "$groupId": {
            ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('coursesTeacher').child($courseId).exists())",
            "members": {
              "$userId": {
                ".write": "auth != null && (auth.uid === $userId || root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('coursesTeacher').child($courseId).exists())"
              }
            }
          }
        }
      }
    },

    "assignmentSubmissions": {
      "$courseId": {
        ".read": true,
        ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('coursesTeacher').child($courseId).exists()) && !newData.exists()",
        "$assignmentId": {
          ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('coursesTeacher').child($courseId).exists())",
          "$submitterKey": {
            ".write": "auth != null && ($submitterKey === auth.uid || $submitterKey.beginsWith('group_') || root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('coursesTeacher').child($courseId).exists())"
          }
        }
      }
    },

    "notifications": {
      // Só a exclusão de curso (admin) lê o nó inteiro para limpar as
      // notificações órfãs de todo mundo; leitura normal continua por usuário.
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        ".write": "auth != null && auth.uid === $userId",
        ".indexOn": ["createdAt"],
        "$notificationId": {
          ".write": "auth != null && (auth.uid === $userId || (!data.exists() && root.child('courses').child(newData.child('courseId').val()).child('userId').val() === auth.uid) || (!data.exists() && root.child('courses').child(newData.child('courseId').val()).child('userId').val() === $userId) || root.child('users').child(auth.uid).child('role').val() === 'admin')"
        }
      }
    },

    "notificationPrefs": {
      // Mesmo motivo de `notifications`: só a exclusão de curso (admin) lê
      // em massa.
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        ".write": "auth != null && auth.uid === $userId"
      }
    },

    "courseMaterials": {
      "$courseId": {
        ".read": true,
        ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('coursesTeacher').child($courseId).exists()) && !newData.exists()",
        "$materialId": {
          ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('coursesTeacher').child($courseId).exists())"
        }
      }
    },

    "courseQuizzes": {
      "$courseId": {
        ".read": true,
        ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('coursesTeacher').child($courseId).exists()) && !newData.exists()",
        "$quizId": {
          ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('coursesTeacher').child($courseId).exists())"
        }
      }
    },

    "courseSlides": {
      "$courseId": {
        ".read": true,
        ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('coursesTeacher').child($courseId).exists()) && !newData.exists()",
        "$slideId": {
          ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('coursesTeacher').child($courseId).exists())"
        }
      }
    },

    "courseVideos": {
      "$courseId": {
        ".read": true,
        ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('coursesTeacher').child($courseId).exists()) && !newData.exists()",
        "$videoId": {
          ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('coursesTeacher').child($courseId).exists())"
        }
      }
    },

    "courseContent": {
      "$courseId": {
        ".read": true,
        ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('coursesTeacher').child($courseId).exists()) && !newData.exists()",
        "$contentId": {
          ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('coursesTeacher').child($courseId).exists())"
        }
      }
    },
    
    "courseVideoComments": {
      "$courseId": {
        ".read": true,
        "$contentId": {
          "$commentId": {
            ".write": "auth != null && ((!data.exists() && newData.child('userId').val() === auth.uid) || (data.exists() && data.child('userId').val() === auth.uid) || root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('coursesTeacher').child($courseId).exists())",
            ".validate": "newData.hasChildren(['text', 'userId', 'userName', 'createdAt']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 1000 && (!data.exists() || newData.child('userId').val() === data.child('userId').val())"
          }
        }
      }
    },

    "courseQuestions": {
      "$courseId": {
        ".read": true,
        ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('coursesTeacher').child($courseId).exists()) && !newData.exists()",
        "$questionId": {
          ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('coursesTeacher').child($courseId).exists() || (!data.exists() && newData.child('userId').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('userId').val() === auth.uid && data.child('discussed').val() !== true))"
        }
      }
    },

    "courseAliases": {
      ".read": true,
      "$aliasId": {
        ".read": true,
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (data.exists() && root.child('courses').child(data.child('courseId').val()).child('userId').val() === auth.uid) || (!data.exists() && root.child('courses').child(newData.child('courseId').val()).child('userId').val() === auth.uid))"
      }
    },

    "courses": {
      // Sem isso, uma leitura do nó INTEIRO (catálogo, importação, checagem de
      // tipo de curso) era negada mesmo com `.read:true` no `$courseId`: esse
      // grau só cobre uma leitura NAQUELE nível ou abaixo, nunca uma listagem
      // do pai — regra que fica óbvia só depois de tirar o `.read:true` da raiz.
      ".read": true,
      "$courseId": {
        ".read": true,
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (data.exists() && data.child('userId').val() === auth.uid) || (!data.exists() && root.child('users').child(auth.uid).child('role').val() === 'teacher'))",

        "closedAt": {
          ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('coursesTeacher').child($courseId).exists())"
        },
        "closedBy": {
          ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('coursesTeacher').child($courseId).exists())"
        }
      }
    },

    "courseAdvancedSettings": {
      "$courseId": {
        ".read": true,
        ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('coursesTeacher').child($courseId).exists())"
      }
    },

    "courseAttendanceSettings": {
      "$courseId": {
        ".read": true,
        ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('coursesTeacher').child($courseId).exists())"
      }
    },

    "customQuizResults": {
      "$courseId": {
        ".read": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('coursesTeacher').child($courseId).exists())",
        ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('coursesTeacher').child($courseId).exists()) && !newData.exists()",
        "$quizId": {
          ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('coursesTeacher').child($courseId).exists())",
          "$userId": {
            ".write": "auth != null && auth.uid === $userId",
            ".read": "auth != null && root.child('courses').child($courseId).child('userId').val() === auth.uid"
          }
        }
      }
    },

    "liveQuizResults": {
      "$courseId": {
        ".read": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('coursesTeacher').child($courseId).exists())",
        ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('coursesTeacher').child($courseId).exists()) && !newData.exists()",
        "$quizId": {
          ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('coursesTeacher').child($courseId).exists())",
          "$userId": {
            ".write": "auth != null && auth.uid === $userId",
            ".read": "auth != null && root.child('courses').child($courseId).child('userId').val() === auth.uid"
          }
        }
      }
    },

    "openEndedAnswers": {
      "$courseId": {
        ".read": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('coursesTeacher').child($courseId).exists())",
        ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('coursesTeacher').child($courseId).exists()) && !newData.exists()",
        "$quizId": {
          ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('coursesTeacher').child($courseId).exists())",
          "$questionId": {
            "$userId": {
              ".write": "auth != null && (auth.uid === $userId || root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('coursesTeacher').child($courseId).exists())",
              ".read": "auth != null && (auth.uid === $userId || root.child('courses').child($courseId).child('userId').val() === auth.uid)"
            }
          }
        }
      }
    },

    "llmModels": {
      ".read": true,
      "$modelId": {
        ".read": true,
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },

    "post": {
      ".read": true,
      "$postId": {
        ".read": true,
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        "likes": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['data'])"
          }
        },
        "dislikes": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['data'])"
          }
        },
        "comentarios": {
          "$comentarioId": {
            ".write": "auth != null && ((!data.exists() && newData.child('uidUsuario').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('uidUsuario').val() === auth.uid) || root.child('users').child(auth.uid).child('role').val() === 'admin')",
            ".validate": "newData.child('comentario').isString() && newData.child('comentario').val().length > 0 && newData.child('comentario').val().length <= 1000"
          }
        }
      }
    },

    "quizGigi": {
      "$courseId": {
        ".read": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('coursesTeacher').child($courseId).exists())",
        ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('coursesTeacher').child($courseId).exists()) && !newData.exists()",
        "$quizId": {
          ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('coursesTeacher').child($courseId).exists())"
        }
      }
    },

    "quizResults": {
      // Telas de professor (notas de um quiz, exclusão de quiz) leem o nó
      // INTEIRO (todo userId) para filtrar por curso depois em memória — não
      // dá para restringir por curso numa leitura que nem tem o courseId no
      // caminho, então a concessão aqui é "é professor de algum curso ou
      // admin", não "é dono deste curso". `$userId/$courseId` abaixo continua
      // sendo a regra fina (aluno só lê o próprio; dono do curso lê o do
      // curso dele).
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'teacher' || root.child('users').child(auth.uid).child('coursesTeacher').exists())",
      "$userId": {
        ".write": "auth != null && auth.uid === $userId",
        "$courseId": {
          ".read": "auth != null && (auth.uid === $userId || root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
          ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin') && !newData.exists()",
          "$quizId": {
            ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')"
          }
        }
      }
    },

    "reports": {
      ".write": false,
      // A lista de admin (fetchAllReports) e a exclusão de curso leem o nó
      // inteiro; a numeração sequencial ao enviar um report (getNextReportNumber,
      // alcançável por quem não está logado) também tenta ler aqui, mas cai com
      // segurança num número por timestamp se a leitura for negada.
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$reportId": {
        ".read": true,
        ".write": "auth != null"
      }
    },

    "studentCourses": {
      // A tela "meus cursos" do próprio aluno (studentCourses/{seuId}) e a
      // agregação de turma do professor (studentCourses inteiro) leem em
      // massa, um nível ACIMA de onde ".read" está declarado abaixo — sem
      // grau aqui, ambas eram negadas mesmo sendo leituras legítimas.
      ".read": "auth != null",
      "$userId": {
        "$courseId":{
          ".write": "auth != null && (auth.uid === $userId || root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('coursesTeacher').child($courseId).exists())",
          ".read": true
        }
      }
    },

    "tags": {
      ".read": true,
      "$tagId": {
        ".read": true,
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },

    "users": {
      ".indexOn": ["email"],
      ".read": "auth != null",
      "$userId": {
        ".read": "auth != null && (auth.uid === $userId || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (auth.uid === $userId || (root.child('users').child(auth.uid).child('role').val() === 'admin' && newData.hasChild('role')))",
        "coursesTeacher": {
          "$courseId": {
            ".write": "auth != null && (auth.uid === $userId || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('courses').child($courseId).child('userId').val() === auth.uid)"
          }
        }
      }
    },

    "videoProgress": {
      // Só a exclusão de curso (admin) lê o nó inteiro para limpar as
      // referências de todo mundo; leitura normal já é pública em `$userId`.
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$userId": {
        ".write": "auth != null && auth.uid === $userId",
        ".read": true,
        "$courseId": {
          ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin') && !newData.exists()",
          "$videoId": {
            ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')"
          }
        }
      }
    }
  }
}
