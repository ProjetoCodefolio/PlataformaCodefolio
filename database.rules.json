        ".read": true,
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },

    "quizGigi": {
      "$courseId": {
        ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin') && !newData.exists()",
        "$quizId": {
          ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
          "$userId": {
            ".write": "auth != null && auth.uid === $userId",
            ".read": "auth != null && root.child('courses').child($courseId).child('userId').val() === auth.uid"
          }
        }
      }
    },

    "quizResults": {
      "$userId": {
        ".write": "auth != null && auth.uid === $userId",
        "$courseId": {
          ".read": "auth != null && root.child('courses').child($courseId).child('userId').val() === auth.uid",
          ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin') && !newData.exists()",
          "$quizId": {
            ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')"
          }
        }
      }
    },

    "reports": {
      ".write": false,
      "$reportId": {
        ".read": true,
        ".write": "auth != null"
      }
    },

    "studentCourses": {
      "$userId": {
        "$courseId":{
          ".write": "auth != null && (auth.uid === $userId || root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
          ".read": true
        }
      }
    },

    "tags": {
      "$tagId": {
        ".read": true,
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },

    "users": {
      ".indexOn": ["email"],
      "$userId": {
        ".read": "auth != null && (auth.uid === $userId || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (auth.uid === $userId || (root.child('users').child(auth.uid).child('role').val() === 'admin' && newData.hasChild('role')))",
        "coursesTeacher": {
          "$courseId": {
            ".write": "auth != null && (auth.uid === $userId || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('courses').child($courseId).child('userId').val() === auth.uid)"
          }
        }
      }
    },

    "videoProgress": {
      "$userId": {
        ".write": "auth != null && auth.uid === $userId",
        ".read": true,
        "$courseId": {
          ".write": "auth != null && (root.child('courses').child($courseId).child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin') && !newData.exists()",
