# Copie este arquivo para .env e preencha com os valores reais.
# .env nunca deve ser commitado.

# Configuração do Firebase (Project settings > General > SDK setup and configuration)
VITE_API_KEY=
VITE_AUTH_DOMAIN=
VITE_PROJECT_ID=
VITE_STORAGE_BUCKET=
VITE_MESSAGING_SENDER=
VITE_APP_ID=
VITE_MEASUREMENT_ID=

# Controla o uso do emulador do Firebase em dev. "production" desliga o
# emulador mesmo rodando `vite` (dev server); vazio/outro valor usa o
# emulador em dev. Não confundir com import.meta.env.PROD (esse sim só é
# true num build de produção real, `vite build`).
VITE_MODE=

# Chave da API da Groq, usada na geração de quiz por IA
VITE_GROQ_API_KEY=

# Chave secreta usada para gerar/validar o hash do PIN de cursos fechados
VITE_PIN_SECRET_KEY=

# Template ID do EmailJS para notificação de novo enunciado/quiz/vídeo/nota/
# grupo (ver src/api/services/emailService.js). Mesma conta/chave pública do
# EmailJS usada no reporte de bug, só o template muda. Envio só acontece em
# build de produção real (EMAIL_NOTIFICATIONS_ENABLED em notifications.js).
VITE_NOTIFICATION_TEMPLATE_ID=
