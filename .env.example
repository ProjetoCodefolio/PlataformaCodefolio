# Copie este arquivo para .env e preencha com os valores reais.
# .env nunca deve ser commitado.

# Configuração do Firebase (Project settings > General > SDK setup and configuration)
VITE_API_KEY=
VITE_AUTH_DOMAIN=
VITE_PROJECT_ID=
VITE_STORAGE_BUCKET=
VITE_MESSAGING_SENDER=
VITE_APP_ID=
VITE_MEASUREMENT_ID=

# Controla o uso do emulador do Firebase em dev. "production" desliga o
# emulador mesmo rodando `vite` (dev server); vazio/outro valor usa o
# emulador em dev. Não confundir com import.meta.env.PROD (esse sim só é
# true num build de produção real, `vite build`).
VITE_MODE=

# Chave da API da Groq, usada na geração de quiz por IA
VITE_GROQ_API_KEY=

# Chave secreta usada para gerar/validar o hash do PIN de cursos fechados
VITE_PIN_SECRET_KEY=

# URL do Worker (Cloudflare) que enfileira e-mail de notificação de novo
# enunciado/quiz/vídeo/nota/grupo — ver emailWorker/ e
# src/api/services/emailService.js. Envio só acontece em build de produção
# real (EMAIL_NOTIFICATIONS_ENABLED em notifications.js).
VITE_EMAIL_WORKER_URL=

# Só pra teste local pontual de e-mail de notificação em `npm run dev` (ver
# notifications.js). Deixe as duas vazias no dia a dia.
VITE_FORCE_EMAIL_NOTIFICATIONS=
VITE_EMAIL_TEST_ALLOWLIST=
