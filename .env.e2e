# Configuração do build de testes E2E (`npm run build:e2e`). Commitado de
# propósito: nada aqui é segredo, porque os emuladores do Firebase aceitam
# qualquer chave. Todas as variáveis do .env.example estão listadas, mesmo as
# vazias, para que nenhuma herde o valor real do .env local.

VITE_API_KEY=e2e-fake-api-key
VITE_AUTH_DOMAIN=localhost
# Precisa ser o mesmo projeto do `firebase emulators:exec --project`.
VITE_PROJECT_ID=plataformacodefolio
VITE_STORAGE_BUCKET=
VITE_MESSAGING_SENDER=
VITE_APP_ID=e2e-fake-app-id
VITE_MEASUREMENT_ID=

# Liga banco e login no emulador (ver src/api/config/runtimeMode.js). O script
# build:e2e também passa isto na linha de comando, que tem precedência sobre
# qualquer VITE_MODE herdado do ambiente.
VITE_MODE=e2e

VITE_GROQ_API_KEY=
VITE_PIN_SECRET_KEY=e2e-pin-secret
VITE_EMAIL_WORKER_URL=
VITE_FORCE_EMAIL_NOTIFICATIONS=
VITE_EMAIL_TEST_ALLOWLIST=
